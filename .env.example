VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public invoice links in emails (production URL, no trailing slash)
VITE_APP_URL=https://your-app-domain.com

# Invoice email + public payment links (Edge Functions — do not put these in .env)
#
# 1. Verify your domain/sender in Resend
# 2. Run SQL migrations in supabase/
# 3. Set secrets (names cannot start with SUPABASE_):
#      supabase secrets set RESEND_API_KEY=re_...
#      supabase secrets set APP_URL=https://your-production-domain.com
#    SUPABASE_SERVICE_ROLE_KEY is auto-injected on deploy — do not set it manually.
# 4. Deploy functions (no Docker required — your app calls these on Supabase cloud):
#      supabase functions deploy send-invoice
#      supabase functions deploy invoice-public
# 5. Use the same email/domain in Settings → Email as your Resend sender
#
# Local function testing (optional — requires Docker Desktop + supabase/functions/.env):
#   npm run functions:serve
