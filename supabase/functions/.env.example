# Optional — only needed for LOCAL function testing (requires Docker Desktop).
# Without Docker, deploy to Supabase cloud instead (see .env.example in project root).
#
#   cp supabase/functions/.env.example supabase/functions/.env
#   npm run functions:serve
#
# Secret names cannot start with SUPABASE_.

SERVICE_ROLE_KEY=your-service-role-key-from-dashboard
RESEND_API_KEY=re_...
APP_URL=http://localhost:5173
